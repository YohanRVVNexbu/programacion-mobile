# Copia este archivo como local.properties (no se sube al repositorio) y ajusta los valores.
sdk.dir=/ruta/al/Android/sdk

# URL base del servicio remoto (debe terminar en "/"). No poner credenciales ni tokens aquí.
recordatorios.apiBaseUrl=https://api.recordatorios.example/

# true: el servicio se simula dentro de la app (interceptor de OkHttp), sin servidor real.
# false: se usa la URL de arriba con una conexión real.
recordatorios.usarBackendSimulado=true
