# Copia este archivo como local.properties (no se sube al repositorio) y ajusta los valores.
sdk.dir=/ruta/al/Android/sdk

# Opcional. Dirección del Emulator Suite de Firebase vista desde el dispositivo (solo variante dev).
#  - Emulador de Android: 10.0.2.2 (valor por defecto)
#  - Dispositivo físico: "localhost" tras ejecutar:  adb reverse tcp:9099 tcp:9099 && adb reverse tcp:8080 tcp:8080
#recordatorios.emuladorHost=10.0.2.2
